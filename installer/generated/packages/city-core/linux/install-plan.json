{
  "actions": [
    {
      "description": "Docker Desktop or Docker Engine is installed and running.",
      "id": "container-runtime",
      "mode": "detect_or_guide",
      "type": "check"
    },
    {
      "description": "Host has enough RAM and disk for the selected profile.",
      "id": "disk-memory",
      "mode": "detect",
      "type": "check"
    },
    {
      "description": "Ollama is available when the selected profile enables local LLM features.",
      "id": "ollama",
      "mode": "optional",
      "type": "check"
    },
    {
      "description": "Suite launcher runtime files are packaged and planned for localhost:18082.",
      "id": "suite-launcher-runtime",
      "mode": "file_and_port_plan",
      "type": "check"
    },
    {
      "description": "Shared staff session env var TOWNLIGHT_CORE_SUITE_SESSION_SECRET is created at runtime if missing and shared with selected services.",
      "id": "shared-staff-session-env",
      "mode": "env_plan",
      "type": "check"
    },
    {
      "townlight_core_requirement": null,
      "display_name": "Townlight Core",
      "module": "townlight_core",
      "proof_required": [
        "install",
        "version_check",
        "compatibility_matrix_check",
        "windows_local_contracts",
        "task_queue_worker"
      ],
      "repo": "townlight/core",
      "type": "install_module"
    },
    {
      "townlight_core_requirement": "1.2.1",
      "display_name": "Townlight Records",
      "module": "townlight_records",
      "proof_required": [
        "install",
        "health_check",
        "restart",
        "repair",
        "backup",
        "restore"
      ],
      "repo": "townlight/sunshine",
      "type": "install_module"
    },
    {
      "townlight_core_requirement": "1.2.0",
      "display_name": "TownlightMeetings",
      "module": "townlight_meetings",
      "proof_required": [
        "install",
        "health_check",
        "restart",
        "repair",
        "backup",
        "restore"
      ],
      "repo": "townlight/meetings",
      "type": "install_module"
    },
    {
      "townlight_core_requirement": "1.2.1",
      "display_name": "TownlightCode",
      "module": "townlight_code",
      "proof_required": [
        "module_selection",
        "install_plan",
        "artifact_resolution",
        "health_check",
        "restart",
        "release_artifacts",
        "release_attestation"
      ],
      "repo": "townlight/ordinances",
      "type": "install_module"
    },
    {
      "townlight_core_requirement": "1.2.1",
      "display_name": "Townlight Notice",
      "module": "townlight_notice",
      "proof_required": [
        "module_selection",
        "install_plan",
        "artifact_resolution",
        "health_check",
        "restart",
        "backup",
        "restore",
        "release_artifacts"
      ],
      "repo": "townlight/notice",
      "type": "install_module"
    },
    {
      "townlight_core_requirement": "1.2.1",
      "display_name": "Townlight Access",
      "module": "townlight_access",
      "proof_required": [
        "module_selection",
        "install_plan",
        "artifact_resolution",
        "health_check",
        "restart",
        "backup",
        "restore",
        "release_artifacts",
        "accessibility_audit",
        "export_correctness"
      ],
      "repo": "townlight/access",
      "type": "install_module"
    },
    {
      "component": "suite-launcher",
      "modules": [
        {
          "href": "http://127.0.0.1:18080/",
          "id": "records",
          "port": 18080
        },
        {
          "href": "http://127.0.0.1:18081/",
          "id": "clerk",
          "port": 18081
        },
        {
          "href": "http://127.0.0.1:18820/",
          "id": "code",
          "port": 18820
        }
      ],
      "port": 18082,
      "shared_staff_session": {
        "env_var": "TOWNLIGHT_CORE_SUITE_SESSION_SECRET",
        "persisted_value_in_plan": false,
        "revocation_env_var": "TOWNLIGHT_CORE_SUITE_SESSION_REVOCATION_FILE",
        "revocation_file": "/townlight-shared/townlight_core_suite_session_revocations.json",
        "value_source": "generated on first install if missing"
      },
      "source": "installer\\runtime\\suite-launcher",
      "type": "configure_runtime",
      "url": "http://127.0.0.1:18082/"
    },
    {
      "profile": "city-core",
      "proof": [
        "health_checks",
        "restart",
        "backup",
        "restore",
        "actionable_failure_copy",
        "suite_launcher_files",
        "suite_launcher_port_config",
        "shared_staff_session_check"
      ],
      "type": "verify_profile"
    }
  ],
  "dry_run": true,
  "host": {
    "machine": "x86_64/arm64",
    "release": "Ubuntu LTS",
    "system": "Linux"
  },
  "menu_style": {
    "description": "Step-by-step setup for operators who want recommendations.",
    "id": "guided",
    "label": "Guided Setup"
  },
  "modules": [
    "townlight_core",
    "townlight_records",
    "townlight_meetings",
    "townlight_code",
    "townlight_notice",
    "townlight_access"
  ],
  "mutates_host": false,
  "profile": "city-core",
  "profile_label": "City Core"
}
