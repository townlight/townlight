        ],
        "inspections-preview": [
          "share/extension/postgis.control",
          "lib/postgis-3.dll"
        ]
      },
      "required_files": [
        "bin/pg_ctl.exe",
        "bin/pg_controldata.exe",
        "bin/initdb.exe",
        "bin/postgres.exe",
        "bin/zlib1.dll",
        "bin/vcruntime140.dll",
        "bin/vcruntime140_1.dll",
        "bin/msvcp140.dll",
        "share/extension/vector.control",
        "lib/vector.dll"
      ]
    },
