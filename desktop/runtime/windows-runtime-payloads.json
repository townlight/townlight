        "postgres"
      ],
      "source_dir": "postgres",
      "destination_dir": "runtime/postgres",
      "profile_required_files": {
        "zoning-beta": [
          "share/extension/postgis.control",
          "lib/postgis-3.dll"
        ],
        "planning-preview": [
          "share/extension/postgis.control",
          "lib/postgis-3.dll"
        ],
        "permitting-preview": [
          "share/extension/postgis.control",
