{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Townlight",
  "version": "1.1.0-2",
  "identifier": "org.civicsuite.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5174",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Townlight",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: asset: http://asset.localhost",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval' http://127.0.0.1:5174",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: asset: http://asset.localhost",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost ws://127.0.0.1:5174 http://127.0.0.1:5174",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "capabilities": ["main-capability"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "publisher": "Townlight",
    "icon": ["icons/icon.ico"],
    "resources": ["../runtime/payload/"],
    "windows": {
      "allowDowngrades": false,
      "wix": {
        "upgradeCode": "a63fc1d3-5437-5f55-89a2-fef93fb1f930",
        "language": "en-US",
        "enableElevatedUpdateTask": false
      }
    }
  }
}
