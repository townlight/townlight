{
  "name": "@civicsuite/desktop",
  "version": "1.1.0-2",
  "private": true,
  "description": "Tauri/WebView2 desktop shell for the Townlight Records Windows beta.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174",
    "build": "vite build",
    "generate-icon": "node scripts/generate-icon.mjs",
    "prepare-runtime-payload": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-runtime-payload.ps1",
    "test": "node tests/static-smoke.mjs && node tests/xss-and-state.mjs",
    "test:browser": "playwright test",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tauri-apps/cli": "2.12.0",
    "vite": "8.0.16"
  }
}
